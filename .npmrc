# pnpm settings for this repository.
#
# node-linker=hoisted: pnpm's default layout uses junctions/symlinks. Inside this workspace the
# sandbox creates junctions with a `Global\`-prefixed target that Windows can read but Node's ESM
# resolver cannot follow, which breaks every package that has its own dependencies (vitest first).
# A flat, real-directory layout avoids symlinks entirely and behaves like npm.
node-linker=hoisted

# esbuild's binary is fetched by a postinstall script; pnpm 11 requires it to be approved.
only-built-dependencies[]=esbuild

# Do not re-run a dependency check before every `pnpm <script>`; CI verifies explicitly.
verify-deps-before-run=false
