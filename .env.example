# Copy to .env.local for local development. Never commit a filled copy.
#
# Where each value comes from:
#   Supabase  — dashboard → Project Settings → API (URL, anon key, service_role key)
#               and → Database → Connection string → Session pooler (DATABASE_URL)
#   Gmail     — the project mailbox; an app password is required (2FA must be on)
#   CRON_SECRET — any long random string; the scheduler sends it as a bearer token

# --- Supabase -----------------------------------------------------------------
# Public: shipped to the browser. Safe by design; row-level security is the guard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never reaches the browser, never logged. Bypasses RLS — treat as a master key.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string. Use the POOLER (port 6543 or the session pooler), not the direct
# connection: serverless functions open short-lived connections and will exhaust a direct one.
DATABASE_URL=

# --- Mailbox ------------------------------------------------------------------
# The project mailbox that receives forwarded application email and sends the digest.
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=

# --- Machine endpoints --------------------------------------------------------
# Bearer secret for /api/ingest, /api/digest and /api/export. The scheduler sends it; nobody else
# should be able to trigger a mailbox read. 32+ random bytes, base64 or hex.
CRON_SECRET=

# --- Kill switches ------------------------------------------------------------
# Set to "true" to stop a job without a deploy. Useful when a bad run is doing damage.
INGEST_PAUSED=false
DIGEST_PAUSED=false
